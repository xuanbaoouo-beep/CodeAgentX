# ============================================================
# CodeAgentX 环境变量模板
# 用法：复制为 .env 后填入真实值（.env 已被 .gitignore 忽略）
#   Windows : copy .env.example .env
#   Linux   : cp .env.example .env
# ============================================================

# ---------- LLM（OpenAI 兼容接口） ----------
LLM_MODEL_ID=Qwen/Qwen2.5-72B-Instruct
LLM_API_KEY=your_api_key
LLM_BASE_URL=https://api-inference.modelscope.cn/v1/
LLM_TEMPERATURE=0.2
# 单次回复上限：审查报告是 JSON，一条 finding 动辄上百 token，
# 太小会被截断成半个 JSON（表现为"无法解析"，实际上是被截断了）
LLM_MAX_TOKENS=16384
LLM_TIMEOUT=60
LLM_MAX_RETRIES=2

# ---------- 向量库 ----------
# memory：内存向量库（默认，零依赖）；qdrant：需 pip install qdrant-client 并启动服务；auto：装了就用 qdrant
VECTOR_BACKEND=memory
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=codeagentx_code

# ---------- Embedding ----------
EMBEDDING_MODEL_ID=text-embedding-v3
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_DIM=1024

# ---------- GitHub ----------
GITHUB_TOKEN=

# ---------- 上下文工程（GSSC） ----------
# 单次构建的上下文 token 预算（含任务说明、证据头等全部渲染开销）
CONTEXT_BUDGET_TOKENS=4000
# 单次构建最多保留的证据条数
CONTEXT_MAX_DOCUMENTS=24

# ---------- 运行时 ----------
LOG_LEVEL=INFO
LOG_DIR=logs
WORKSPACE_DIR=./data/outputs
